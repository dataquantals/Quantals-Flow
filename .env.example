# QuantalFlow environment
#
# Copy to `.env.local` for local development (loaded automatically by
# server/config.js and Convex CLI). In production, set the same names in your
# host's environment settings — never commit real secrets.

# ---------- HTTP server ----------
PORT=12000
HOST=0.0.0.0
APP_ORIGIN=
DB_FILE=

# ---------- Seed account (npm run seed) ----------
SEED_EMAIL=
SEED_PASSWORD=
SEED_NAME=

# ---------- Convex (mirror & reactive store) ----------
# Connected project: team `data-quantals`, project `quantals-flow`
CONVEX_DEPLOYMENT=dev:agreeable-starfish-202
CONVEX_URL=https://agreeable-starfish-202.convex.cloud
CONVEX_SITE_URL=https://agreeable-starfish-202.convex.site
# Shared server-to-Convex secret (`npx convex env set SYNC_SECRET <value>`):
SYNC_SECRET=

# ---------- Clerk SSO (optional) ----------
CLERK_APP_ID=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---------- AI (Edit with AI / plan copilot) ----------
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# ---------- Redis Cloud (optional cache + RediSearch) ----------
REDIS_URL=

# ---------- Cloudinary (Files page signed uploads) ----------
CLOUDINARY_URL=
CLOUDINARY_FOLDER=circuit-overseers-visit

# ---------- Vercel only ----------
API_ORIGIN=
