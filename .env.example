# QuantalFlow environment
#
# Copy to `.env.local` for local development (loaded automatically by
# server/config.js). In production, set the same names in your host's
# environment settings — never commit real values.

# ---------- HTTP server ----------
# Port the Node server listens on locally.
PORT=12000
HOST=0.0.0.0

# Public origin of the running server, e.g. https://app.example.com.
# Used for the same-origin check on POST/PATCH/DELETE. Leave unset when the
# server is reached directly on its own host; set it to the browser-facing
# origin when a proxy (Vercel rewrite/function) sits in front of the API.
APP_ORIGIN=

# SQLite file. Defaults to ./data/app.db.
DB_FILE=

# ---------- Seed account (npm run seed) ----------
SEED_EMAIL=
SEED_PASSWORD=
SEED_NAME=

# ---------- Convex (mirror store) ----------
# Deployment URLs are not secrets; the deploy key is.
CONVEX_URL=https://<deployment>.convex.cloud
CONVEX_SITE_URL=https://<deployment>.convex.site
CONVEX_DEPLOY_KEY=

# Accepted aliases for the same values:
# NEXT_PUBLIC_CONVEX_URL (used for CONVEX_URL)

# ---------- Clerk SSO (optional) ----------
# Email + password works without these; set them to enable the Clerk buttons.
CLERK_APP_ID=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Accepted aliases for the publishable key:
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY, VITE_CLERK_PUBLISHABLE_KEY

# ---------- AI (Edit with AI / plan copilot) ----------
DEEPSEEK_API_KEY=

# ---------- Vercel only ----------
# Absolute origin of the Node API that the Vercel serverless proxy in
# api/[...path].js forwards /api/* to. Leave unset for the single-host
# deployments (Railway/Render/Fly/VPS), where the server serves the site too.
API_ORIGIN=
