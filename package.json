{
  "name": "quantalflow-clone",
  "version": "1.0.0",
  "private": true,
  "description": "QuantalFlow homepage clone with a real backend for authentication",
  "type": "module",
  "engines": {
    "node": ">=22.x"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build": "node src/tools/build.js",
    "build:vercel": "node src/tools/build.js && node scripts/assemble-public.mjs",
    "audit:links": "node src/tools/link-audit.mjs",
    "seed": "node server/seed.js",
    "convex:dev": "node scripts/convex-push.mjs --watch",
    "convex:push": "node scripts/convex-push.mjs",
    "convex:codegen": "convex codegen",
    "convex:backfill": "node scripts/convex-backfill.mjs",
    "redis:verify": "node scripts/verify-redis.mjs",
    "test": "node --test server/tests/*.test.js"
  },
  "dependencies": {
    "convex": "^1.46.0",
    "redis": "^6.4.0",
    "redis-om": "^0.4.7"
  }
}
