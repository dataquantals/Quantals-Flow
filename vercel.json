{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/router?__api_path=$1" },
    { "source": "/app/(.*)", "destination": "/app/index.html" },
    { "source": "/dashboard/notepad", "destination": "/notepad/index.html" },
    { "source": "/dashboard/notepad/", "destination": "/notepad/index.html" },
    { "source": "/dashboard/quotation", "destination": "/quotation/index.html" },
    { "source": "/dashboard/quotation/", "destination": "/quotation/index.html" },
    { "source": "/dashboard/invoice", "destination": "/invoice/index.html" },
    { "source": "/dashboard/invoice/", "destination": "/invoice/index.html" },
    { "source": "/dashboard/receipt", "destination": "/receipt/index.html" },
    { "source": "/dashboard/receipt/", "destination": "/receipt/index.html" },
    { "source": "/dashboard/knowledge", "destination": "/knowledge/index.html" },
    { "source": "/dashboard/knowledge/", "destination": "/knowledge/index.html" },
    { "source": "/dashboard/documents", "destination": "/documents/index.html" },
    { "source": "/dashboard/documents/", "destination": "/documents/index.html" },
    { "source": "/dashboard/os", "destination": "/documents/index.html" },
    { "source": "/dashboard/os/", "destination": "/documents/index.html" },
    { "source": "/dashboard/leaf", "destination": "/leaf/index.html" },
    { "source": "/dashboard/leaf/", "destination": "/leaf/index.html" },
    { "source": "/dashboard/crm", "destination": "/crm/index.html" },
    { "source": "/dashboard/crm/", "destination": "/crm/index.html" },
    { "source": "/dashboard/templates", "destination": "/resources/templates/index.html" },
    { "source": "/dashboard/templates/", "destination": "/resources/templates/index.html" },
    { "source": "/dashboard/(.*)", "destination": "/dashboard/index.html" }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
